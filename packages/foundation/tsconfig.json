{
  // 타입 검사용: src와 테스트·설정 파일을 함께 본다.
  // Node가 직접 실행하는 scripts와 CLI 픽스처(test/fixtures)는 tsconfig.scripts.json이 본다.
  // 배포 출력(d.ts)에 필요한 isolatedDeclarations는 tsconfig.build.json이 src에만 적용한다.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "declaration": false,
    "isolatedDeclarations": false
  },
  "include": ["src", "test", "tsdown.config.ts", "vitest.config.ts"],
  "exclude": ["test/fixtures"]
}
