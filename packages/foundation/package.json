{
  "name": "@tide-tds/foundation",
  "version": "0.1.0",
  "description": "Tide 디자인 시스템의 Token과 CSS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chane81/tide-design-system.git",
    "directory": "packages/foundation"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tailwind-merge": {
      "types": "./dist/tailwind-merge.d.ts",
      "default": "./dist/tailwind-merge.js"
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tailwindcss/node": "catalog:",
    "@types/node": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "tailwind-merge": "^3"
  },
  "peerDependenciesMeta": {
    "tailwind-merge": {
      "optional": true
    }
  }
}
