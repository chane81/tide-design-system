{
  // 타입 검사용: src와 테스트·설정 파일을 함께 본다.
  // 배포 출력(d.ts)에 필요한 isolatedDeclarations는 tsconfig.build.json이 src에만 적용한다.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client", "@vitest/browser-playwright"],
    "declaration": false,
    "isolatedDeclarations": false
  },
  "include": ["src", "test", "vite.config.ts", "vitest.config.ts"]
}
