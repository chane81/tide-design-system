{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // 이름표에서 아이콘 Component와 LICENSE를 만든다. 결과는 커밋하지 않으므로
    // 이 패키지의 build·typecheck·test가 모두 먼저 기다린다(turbo 2.11.10 Package Configurations).
    "generate": { "outputs": ["src/generated/**", "LICENSE"] },
    "build": { "dependsOn": ["^build", "generate"] },
    "typecheck": { "dependsOn": ["^build", "generate"] },
    "test": { "dependsOn": ["^build", "generate"] }
  }
}
