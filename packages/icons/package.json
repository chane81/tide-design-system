{
  "name": "@tide-design/icons",
  "version": "0.11.3",
  "description": "Tide 디자인 시스템의 React 아이콘 Component",
  "keywords": [
    "design-system",
    "icons",
    "lucide",
    "react",
    "react-icons",
    "tide",
    "tide-design"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chane81/tide-design-system.git",
    "directory": "packages/icons"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
